# ---------------------------------------------------------------------------
# KAYAK Bid Optimizer Pro — environment template
# Copy to `.env` for local development:  cp .env.example .env
# NEVER commit a real `.env`. Staging/production values live in the platform's
# encrypted environment store (Vercel / Railway / Render), never in the repo.
# ---------------------------------------------------------------------------

# --- Application metadata ---------------------------------------------------
APP_NAME=KAYAK Bid Optimizer Pro
NODE_ENV=development

# --- Backend (FastAPI) ------------------------------------------------------
# Async SQLAlchemy URL. In Docker Compose the host is the `db` service.
# For host-local runs use: postgresql+asyncpg://kayak:kayak@localhost:5432/kayak_bid_optimizer
DATABASE_URL=postgresql+asyncpg://kayak:kayak@db:5432/kayak_bid_optimizer

# Comma-separated list of browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000

# Logging: console (dev) | json (staging/production)
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- Frontend (Next.js) -----------------------------------------------------
# Browser-exposed. Points at the backend's public API base.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# --- PostgreSQL (Docker Compose only) ---------------------------------------
POSTGRES_USER=kayak
POSTGRES_PASSWORD=kayak
POSTGRES_DB=kayak_bid_optimizer
